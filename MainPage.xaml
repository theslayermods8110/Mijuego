<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mijuego.MainPage"
             BackgroundColor="#1A1A2E">

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label
            Text="🔥 MI PRIMER JUEGO 🔥"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalOptions="Center" />

        <Label
            x:Name="PuntosLabel"
            Text="Puntos: 0"
            FontSize="40"
            FontAttributes="Bold"
            TextColor="#FFD700"
            HorizontalOptions="Center" />

        <Label
            x:Name="NivelLabel"
            Text="Nivel: 1"
            FontSize="20"
            TextColor="White"
            HorizontalOptions="Center" />

        <Button
            x:Name="JugarBtn"
            Text="¡TOCAME!"
            FontSize="30"
            FontAttributes="Bold"
            BackgroundColor="#E94560"
            TextColor="White"
            HeightRequest="150"
            CornerRadius="75"
            Clicked="OnJugarClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Reiniciar"
            BackgroundColor="Gray"
            TextColor="White"
            Clicked="OnReiniciarClicked" />

    </VerticalStackLayout>
</ContentPage>
